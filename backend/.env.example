# AI 서버 설정 예시 (backend/app/ai.py 가 환경변수로 읽음)
# 이 파일은 자동으로 로드되지 않습니다. 실행하는 터미널에서 환경변수로 설정하세요 (README "AI 서버 설정").
# 실제 값을 넣은 .env 는 커밋하지 마세요 (.gitignore 에 .env 포함).

# OpenAI 호환 API 주소. 끝에 /v1 까지 포함
#   개발용:      https://mcu.osxteams.net/v1
#   내부 테스트: http://192.168.1.221:8000/v1 (ai.py 기본값)
AI_BASE_URL=https://mcu.osxteams.net/v1

# 모델 이름 (GET {AI_BASE_URL}/models 로 확인). qwen 은 이미지 입력 가능
AI_MODEL=qwen

# 개발용 서버는 키가 필요 없음(아무 값이나 OK). 키가 필요한 서버를 쓰면 실제 키는 커밋 금지
AI_API_KEY=anything

# 1 이면 AI 대신 예시 데이터로 응답 (발표용 대비)
MOCK=
